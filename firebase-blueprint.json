          "maxLength": 80
        },
        "userArea": {
          "type": "string",
          "description": "Colleague sales area.",
          "minLength": 0,
          "maxLength": 80
        },
        "productId": {
          "type": "string",
          "description": "Product module ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "productName": {
          "type": "string",
          "description": "Product brand name.",
