  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Trusted RBAC collection storing Regional Manager administrator UIDs."
    },
    "/profiles/{userId}": {
      "schema": "PublicProfile",
      "description": "Organization-visible colleague profiles stripped of PII."
    },
    "/users_private/{userId}": {
      "schema": "PrivateUserInfo",
      "description": "Owner-and-admin isolated PII records containing email and employee code."
    },
    "/products/{productId}": {
      "schema": "ProductModule",
      "description": "Novatek pharmaceutical product training modules."
    },
    "/products/{productId}/resources/{resourceId}": {
      "schema": "LearningResource",
      "description": "Subcollection of text, video, and image learning resources per product."
    },
    "/products/{productId}/questions/{questionId}": {
      "schema": "ExamQuestion",
      "description": "Subcollection of MCQ and written text exam questions per product."
    },
    "/learning_progress/{progressId}": {
      "schema": "LearningProgress",
      "description": "Colleague learning resource completion records keyed as {userId}_{productId}."
    },
    "/exam_submissions/{submissionId}": {
      "schema": "ExamSubmission",
      "description": "Colleague exam submissions with MCQ and text responses."
    },
    "/leaderboard/{entryId}": {
      "schema": "LeaderboardEntry",
      "description": "Non-PII product certification leaderboard entries keyed as {userId}_{productId}."
    }
  }
}
